+
+  // Update actual state
+  always @(posedge clk_i or posedge rst_i)
+    if (rst_i) state_q <= STATE_INIT;
+    // Delaying...
+    else if (delay_r != {DELAY_W{1'b0}}) state_q <= STATE_DELAY;
+    else state_q <= next_state_r;
