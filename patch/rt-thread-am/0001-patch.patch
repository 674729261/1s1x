diff --git a/bsp/abstract-machine/extra_soc.ld b/bsp/abstract-machine/extra_soc.ld
new file mode 100644
index 000000000..4546d674e
--- /dev/null
+++ b/bsp/abstract-machine/extra_soc.ld
@@ -0,0 +1,54 @@
+SECTIONS {
+  .data.extra : {
+    . = ALIGN(8);
+    rt_begin = .;
+
+    /* section information for finsh shell */
+    . = ALIGN(8);
+    __fsymtab_start = .;
+    KEEP(*(FSymTab))
+    __fsymtab_end = .;
+
+    . = ALIGN(8);
+    __vsymtab_start = .;
+    KEEP(*(VSymTab))
+    __vsymtab_end = .;
+
+    /* section information for initial. */
+    . = ALIGN(8);
+    __rt_init_start = .;
+    KEEP(*(SORT(.rti_fn*)))
+    __rt_init_end = .;
+
+    . = ALIGN(8);
+    __rt_utest_tc_tab_start = .;
+    KEEP(*(UtestTcTab))
+    __rt_utest_tc_tab_end = .;
+
+    . = ALIGN(8);
+    __am_apps_data_start = .;
+    *(__am_apps.data*)
+    *(__am_apps.sdata*)
+    __am_apps_data_end = .;
+
+    . = ALIGN(8);
+  } > sdram AT> prog
+
+  rt_load_begin = LOADADDR(.data.extra);
+  rt_load_end = LOADADDR(.data.extra) + SIZEOF(.data.extra);
+}
+INSERT BEFORE .data;
+
+SECTIONS {
+  .bss.extra (NOLOAD) : {
+    . = ALIGN(8);
+    __am_apps_bss_start = .;
+    *(__am_apps.bss*)
+    *(__am_apps.sbss*)
+    *(__am_apps.scommon*)
+    __am_apps_bss_end = .;
+
+    . = ALIGN(8);
+  } > sdram
+}
+INSERT BEFORE .bss;
