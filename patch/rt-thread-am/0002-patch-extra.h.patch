-#define seekdir   rt_seekdir
+#define statfs rt_statfs
+#define fstatfs rt_fstatfs
+#define mkdir rt_mkdir
+#define rmdir rt_rmdir
+#define opendir rt_opendir
+#define readdir rt_readdir
+#define telldir rt_telldir
