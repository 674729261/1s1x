+__attribute__((section(".ssbl"))) static void *
+__ssbl__memcpy(void *out, const void *in, size_t n) {
+  unsigned char *d = (unsigned char *)out;
+  const unsigned char *s = (const unsigned char *)in;
+
+  while ((((uintptr_t)d) & 0x3) && n) {
+    *d++ = *s++;
+    n--;
